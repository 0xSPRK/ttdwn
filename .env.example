# ttdwn Environment Configuration
# Copy to .env and customize

# Web UI server port (default: 8080)
PORT=8080

# Download directory inside container (default: /downloads)
DOWNLOAD_DIR=/downloads

# Maximum concurrent downloads (default: 2)
MAX_CONCURRENT=2

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# Optional: HTTP Basic Auth for web UI
# If both are set, authentication is required
# WEBUI_USER=admin
# WEBUI_PASSWORD=changeme