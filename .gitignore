# ttdwn .gitignore

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
*.egg-info/
build/
dist/

# Virtual environments
venv/
env/
.env
.env.*

# IDE
.repowise/
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Downloads (generated files)
downloads/
*.mp4
*.mkv
*.webm
*.mov
*.mp3
*.m4a
*.opus
*.wav
*.jpg
*.jpeg
*.png
*.webp
*.gif

# Backups
*backup*.tar.gz
*backup*.tgz

# Test artifacts
tests/__pycache__/
tests/*.pyc