# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# --- packaging / build ------------------------------------------------------
build/
dist/
*.egg-info/
*.egg
*.whl
MANIFEST
.eggs/
pip-wheel-metadata/

# --- virtual environments ---------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version
*.egg-link

# --- test & tooling caches --------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
.benchmarks/

# --- ttdwn runtime output ---------------------------------------------------
# downloaded media and intermediates
*.mp4
*.m4a
*.mp3
*.opus
*.wav
*.jpg
*.jpeg
*.png
*.webp
*.part
*.tmp.mp4

# sidecars written by --thumbnail / --metadata / --music
*.sound.m4a
*.fs.mp4

# keep artwork that belongs to the repository
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.webp
!assets/**/*.png
!assets/**/*.jpg
!assets/**/*.webp

# --- credentials & local config --------------------------------------------
# Netscape cookie exports are secrets: never commit them
cookies.txt
*cookies*.txt
.netrc

# --- editors & operating systems -------------------------------------------
.repowise
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# --- local scratch ----------------------------------------------------------
*.log
links.txt
out/
scratch/
