root = true

# Python sources are UTF-8 without BOM, LF line endings. A file saved as
# UTF-16 fails with "SyntaxError: source code string cannot contain null
# bytes", so make the intended encoding explicit for every editor.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json,toml}]
indent_size = 2

[Makefile]
indent_style = tab
